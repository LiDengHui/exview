    "@vitejs/plugin-vue": "^6.0.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "element-plus": "^2.11.0"
  },
  "dependencies": {
    "@exview/schema-shared": "workspace:*"
