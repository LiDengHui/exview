{
  "name": "exview-workspace",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @exview/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "release:beta:check": "bash scripts/release-beta.sh",
    "release:version": "node scripts/bump-version.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "release:beta:check:dry": "bash scripts/release-beta.sh --dry-run",
    "release:notes:draft": "node scripts/release-notes-draft.mjs",
    "release:publish": "bash scripts/release-publish.sh",
    "release:publish:dry": "bash scripts/release-publish.sh --tag beta --dry-run",
    "release:all": "bash scripts/release-all.sh",
    "release:all:dry": "bash scripts/release-all.sh --version 0.0.0-beta.0 --tag beta --dry-run"
  },
  "pnpm": {
    "overrides": {
      "editorconfig": "1.0.7",
      "minimatch": "9.0.7"
    }
  }
}
