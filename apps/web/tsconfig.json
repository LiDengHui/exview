{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "vitest.config.ts",
    "config/**/*.ts"
  ]
}
